{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/skill-creator/aggregated-results.schema.json",
  "title": "Skill Creator Aggregated Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "graded_runs", "summary"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "skill_path",
        "provider",
        "model",
        "effort",
        "timestamp"
      ],
      "properties": {
        "skill_name": {
          "type": "string",
          "minLength": 1
        },
        "skill_path": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "graded_runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graded_run"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/run_type_summary"
      }
    }
  },
  "$defs": {
    "graded_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eval_id", "eval_name", "run_type", "result", "grading"],
      "properties": {
        "eval_id": {
          "type": "integer"
        },
        "eval_name": {
          "type": ["string", "null"]
        },
        "run_type": {
          "type": "string",
          "enum": ["skill", "baseline"]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pass_rate",
            "passed",
            "failed",
            "total",
            "time_seconds",
            "tokens"
          ],
          "properties": {
            "pass_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "time_seconds": {
              "type": "number",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "grading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executive_summary", "results"],
          "properties": {
            "executive_summary": {
              "type": "string"
            },
            "results": {
              "$ref": "https://agent-skills.local/skill-creator/grading.schema.json#/properties/results"
            }
          }
        }
      }
    },
    "run_type_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass_rate", "time_seconds", "tokens"],
      "properties": {
        "pass_rate": {
          "$ref": "#/$defs/stats"
        },
        "time_seconds": {
          "$ref": "#/$defs/stats"
        },
        "tokens": {
          "$ref": "#/$defs/stats"
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "stddev", "min", "max"],
      "properties": {
        "mean": {
          "type": "number"
        },
        "stddev": {
          "type": "number",
          "minimum": 0
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    }
  }
}
