{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "extends": ["@meza/biome"],
  "files": {
    "includes": [
      "**",
      "!.tmp/**",
      "!design/**",
      "!dist/**",
      "!legaci-viewer/**",
      "!node_modules/**",
      "!reports/**",
      "!test-results/**"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnresolvedImports": "off"
      }
    }
  }
}
