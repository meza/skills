{
  "name": "eval-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "biome:fix": "biome check --write .",
    "coverage": "vitest run --coverage",
    "dev": "npm run dev:server",
    "dev:server": "npm run fixture:visual && tsx watch --clear-screen=false scripts/devServer.ts .tmp/visual-fixture",
    "fixture:visual": "tsx tests/fixtures/writeVisualFixture.ts",
    "serve": "tsx src/server/main.ts",
    "serve:visual": "npm run build && npm run fixture:visual && npm run serve -- .tmp/visual-fixture",
    "style:check": "stylelint \"src/client/**/*.css\"",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:docker": "docker run --rm -t -v \".:/work\" -w /work/skills/.stable/skill-creator/eval-viewer mcr.microsoft.com/playwright:v1.60.0-noble /bin/bash -lc \"npm i --no-package-lock && npm run test:visual\" && npm i",
    "test:visual:update": "run-s test:visual:update:local test:visual:update:docker",
    "test:visual:update:local": "playwright test --update-snapshots changed",
    "test:visual:update:docker": "docker run --rm -t -v \".:/work\" -w /work/skills/.stable/skill-creator/eval-viewer mcr.microsoft.com/playwright:v1.60.0-noble /bin/bash -lc \"npm i --no-package-lock && npm run test:visual:update:local\" && npm i"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "fastify": "^5.8.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@meza/biome": "^1.2.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.14",
    "jsdom": "^27.2.0",
    "memfs": "^4.57.3",
    "npm-run-all2": "^8.0.4",
    "postcss-preset-env": "^11.3.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
