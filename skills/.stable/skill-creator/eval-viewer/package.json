{
  "name": "eval-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "biome:fix": "biome check --write .",
    "coverage": "vitest run --coverage",
    "doctor": "react-doctor --verbose --full --lint --no-dead-code --fail-on warning",
    "dev": "npm run dev:server",
    "dev:server": "npm run build && npm run fixture:visual && tsx watch --clear-screen=false scripts/devServer.ts .tmp/visual-fixture",
    "fixture:visual": "tsx tests/fixtures/writeVisualFixture.ts",
    "serve": "tsx src/server/main.ts",
    "serve:visual": "npm run build && npm run fixture:visual && npm run serve -- .tmp/visual-fixture",
    "style:check": "stylelint \"src/client/**/*.css\"",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:docker": "docker run --rm -t -v \".:/work\" -v \"/work/node_modules\" -v \"../schemas:/schemas:ro\" -w /work mcr.microsoft.com/playwright:v1.60.0-noble /bin/bash -lc \"npm ci && npm run test:visual\"",
    "test:visual:update": "run-s test:visual:update:local test:visual:update:docker",
    "test:visual:update:local": "playwright test --update-snapshots changed",
    "test:visual:update:docker": "docker run --rm -t -v \".:/work\" -v \"/work/node_modules\" -v \"../schemas:/schemas:ro\" -w /work mcr.microsoft.com/playwright:v1.60.0-noble /bin/bash -lc \"npm ci && npm run test:visual:update:local\"",
    "validate": "run-s \"biome:fix -- --error-on-warnings\" style:check coverage build"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "8.20.0",
    "fastify": "5.8.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@meza/biome": "1.3.0",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.12.4",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.7",
    "jsdom": "29.1.1",
    "memfs": "4.64.0",
    "npm-run-all2": "9.0.2",
    "postcss-preset-env": "11.3.2",
    "stylelint": "17.14.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.22.3",
    "typescript": "7.0.2",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": "24"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
