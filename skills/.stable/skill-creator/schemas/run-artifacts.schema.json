{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/skill-creator/run-artifacts.schema.json",
  "title": "Skill Creator Run Artifacts Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill_name", "eval", "run_type", "artifacts", "schema_path"],
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "eval": {
      "$ref": "evals.schema.json#/$defs/eval"
    },
    "run_type": {
      "type": "string",
      "enum": ["skill", "baseline"]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "results_dir_path",
        "working_dir_path",
        "run_transcript_path",
        "raw_output_path",
        "timing_path",
        "turns"
      ],
      "properties": {
        "results_dir_path": {
          "type": "string",
          "minLength": 1
        },
        "working_dir_path": {
          "type": ["string", "null"]
        },
        "run_transcript_path": {
          "type": "string",
          "minLength": 1
        },
        "raw_output_path": {
          "type": "string",
          "minLength": 1
        },
        "timing_path": {
          "type": "string",
          "minLength": 1
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn", "response_path", "transcript_path"],
            "properties": {
              "turn": {
                "type": "integer",
                "minimum": 1
              },
              "response_path": {
                "type": "string",
                "minLength": 1
              },
              "transcript_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "schema_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
