{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skills.local/skill-creator/evals.schema.json",
  "title": "Skill Creator Eval Definitions",
  "type": "object",
  "additionalProperties": true,
  "required": ["evals"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [".", ".."]
      },
      "pattern": "^[^\\\\/:]+$"
    },
    "fixture_repo": {
      "type": "string",
      "minLength": 1
    },
    "fixture_ref": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "fixture_base_path": {
      "type": "string",
      "minLength": 1
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/eval"
      }
    }
  },
  "$defs": {
    "eval": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "turns"],
      "properties": {
        "id": {
          "type": "integer"
        },
        "eval_name": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "fixture_in_workdir": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outcome_expectations": {
          "$ref": "#/$defs/expectations"
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/turn"
          }
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": true,
      "required": ["prompt"],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expectations": {
          "$ref": "#/$defs/expectations"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
