#!/usr/bin/env node
'use strict'

const { existsSync, readdirSync } = require('node:fs')
const { join, resolve } = require('node:path')
const { spawnSync } = require('node:child_process')

const INTERNAL_PUSH = 'SEMANTIC_RELEASE_INTERNAL_PUSH'
const repoRoot = resolve(__dirname, '..')

function semanticReleaseExecutable(platform) {
  return platform === 'win32' ? 'semantic-release.cmd' : 'semantic-release'
}

function pluginDirectories(root) {
  const pluginsRoot = join(root, 'plugins')

  return readdirSync(pluginsRoot, { withFileTypes: true })
    .filter(entry => entry.isDirectory())
    .map(entry => join(pluginsRoot, entry.name))
    .filter(directory => existsSync(join(directory, '.releaserc.cjs')))
    .sort()
}

function runSemanticRelease(spawn, executable, cwd, args, env, platform) {
  const windows = platform === 'win32'
  const command = windows ? env.ComSpec || 'cmd.exe' : executable
  const commandArgs = windows
    ? ['/d', '/s', '/c', [executable, ...args].join(' ')]
    : args
  const result = spawn(command, commandArgs, {
    cwd,
    env,
    stdio: 'inherit',
    shell: false,
  })

  if (result.error) {
    console.error(`Unable to run ${executable}: ${result.error.message}`)
    return 1
  }

  return result.status ?? 1
}

function run({
  argv = process.argv.slice(2),
  env = process.env,
  platform = process.platform,
  spawn = spawnSync,
  root = repoRoot,
} = {}) {
  if (env[INTERNAL_PUSH] === '1') return 0

  const release = argv.includes('--release')
  const executable = semanticReleaseExecutable(platform)
  const childEnv = release
    ? { ...env, [INTERNAL_PUSH]: '1' }
    : { ...env, SEMANTIC_RELEASE_CHECK: '1' }
  const componentArgs = release ? ['--no-ci'] : ['--dry-run', '--no-ci']

  for (const directory of pluginDirectories(root)) {
    const status = runSemanticRelease(
      spawn,
      executable,
      directory,
      componentArgs,
      childEnv,
      platform
    )
    if (status !== 0) return status
  }

  const marketplaceArgs = release ? ['--no-ci'] : ['--dry-run', '--no-ci']

  return runSemanticRelease(
    spawn,
    executable,
    root,
    marketplaceArgs,
    childEnv,
    platform
  )
}

if (require.main === module) process.exitCode = run()

module.exports = {
  INTERNAL_PUSH,
  pluginDirectories,
  run,
  semanticReleaseExecutable,
}
